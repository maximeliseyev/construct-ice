# ── Required ─────────────────────────────────────────────────────────────────

# Primary domain pointing at this VPS. ACME cert is issued for this name;
# clients pin its SPKI; relay --cert uses live/<DOMAIN>/.
DOMAIN=front.example.com

# Additional SAN names on the same cert, comma-separated. Each needs A/AAAA → VPS.
# Leave empty if only $DOMAIN is needed.
EXTRA_DOMAINS=

# Contact email for Let's Encrypt expiry notices.
EMAIL=ops@example.com

# Private cover image (required). Not built from this repository.
# See deploy/COVER.md and construct-docs decisions/veil-example-cover-modularity.md
COVER_IMAGE=ghcr.io/<you>/<private-cover>:latest

# Construct gRPC backend the tunnel forwards to (host:port).
# Remote front: public Construct endpoint over TLS (compose prod uses --backend-tls).
#   BACKEND=backend.example.com:443
#   BACKEND_SNI=backend.example.com
# Co-located backend only: host.docker.internal:50051 and drop --backend-tls.
BACKEND=backend.example.com:443

# Issuer (home-server) Ed25519 PUBLIC key, hex — offline capability verify.
ISSUER_PUBKEY=

# ── Chain mode (relay_domestic only) ─────────────────────────────────────────
# Overlay: docker compose -f docker-compose.prod.yml -f docker-compose.chain.yml
# Keep real IPs / SNIs / SPKI pins in private ops — do not commit them here.
#
# CHAIN_UPSTREAM_ADDR=<UPSTREAM_IP>:443
# CHAIN_UPSTREAM_SNI=<clean-front-hostname>
# CHAIN_UPSTREAM_SPKI=<sha256 hex of clean front SPKI>
# Files on volume chain-data: veil_sk.hex + capability.b64 (ROLE_RELAY).
# See deploy/CHAIN.md.

# ── Optional ─────────────────────────────────────────────────────────────────

# Validity used by local provisioning helpers when printing next commands.
CAPABILITY_DAYS=60
RUST_LOG=info
